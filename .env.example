# Copy this file to ".env" and fill it in. NEVER commit the real .env file.

NODE_ENV=production
PORT=3000

# The public address of your site, with https. Used for links, cookies and host checking.
SITE_URL=https://your-domain.com

# REQUIRED in production: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Number of reverse proxies in front of the app (Cloudflare, nginx, Render, Railway = 1; Cloudflare + nginx = 2).
# Leave blank if the app is exposed directly. Needed so rate limiting sees real visitor IPs.
TRUST_PROXY=1

# ---- FiveM server ----
# Where your FiveM server answers HTTP (ip:port, usually 30120). Powers the live "players online" board.
# Make sure the server's endpoints are reachable from the website host. Leave blank to show "Status unavailable".
FIVEM_STATUS_HOST=
# What players paste into the F8 console. Example: connect cfx.re/join/abc123  or  connect 1.2.3.4:30120
FIVEM_CONNECT=connect cfx.re/join/your-code
FIVEM_MAX_PLAYERS=128

# ---- Links (leave blank to hide) ----
DISCORD_INVITE=
INSTAGRAM_URL=
YOUTUBE_URL=
TIKTOK_URL=
SUPPORT_EMAIL=support@your-domain.com

# ---- Sign-ups ----
REGISTRATION_OPEN=true

# ---- Optional: Cloudflare Turnstile (free CAPTCHA) for login and sign-up ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- Optional: where the database file lives (back this up!) ----
# DB_PATH=/var/data/fidecity.db
